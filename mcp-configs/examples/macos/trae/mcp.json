{
  "mcpServers": {
    "shopdate-jd": {
      "command": "/SHOPDATE/.venv/bin/python",
      "args": [
        "/SHOPDATE/shopdate.py",
        "jd",
        "mcp"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONDONTWRITEBYTECODE": "1",
        "TB_STATE_ROOT": "/SHOPDATE/.local/state",
        "SYCM_MODE": "extension",
        "ALIMAMA_MODE": "extension",
        "JD_ONLY_EXTENSION_IDS": "nipicallldlddjelmaghkbbjaannlpib",
        "JD_STORES_ONLY_EXTENSION_IDS": "nipicallldlddjelmaghkbbjaannlpib",
        "SYCM_ONLY_EXTENSION_IDS": "nipicallldlddjelmaghkbbjaannlpib",
        "ALIMAMA_ONLY_EXTENSION_IDS": "nipicallldlddjelmaghkbbjaannlpib",
        "TB_ACCOUNT_ONLY_EXTENSION_IDS": "nipicallldlddjelmaghkbbjaannlpib",
        "TB_STORES_ONLY_EXTENSION_IDS": "nipicallldlddjelmaghkbbjaannlpib",
        "START_MCP_TIMEOUT_MS": "120000",
        "RUN_MCP_TIMEOUT_MS": "600000"
      }
    },
    "shopdate-symc": {
      "command": "/SHOPDATE/.venv/bin/python",
      "args": [
        "/SHOPDATE/shopdate.py",
        "symc",
        "mcp"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONDONTWRITEBYTECODE": "1",
        "TB_STATE_ROOT": "/SHOPDATE/.local/state",
        "SYCM_MODE": "extension",
        "ALIMAMA_MODE": "extension",
        "JD_ONLY_EXTENSION_IDS": "nipicallldlddjelmaghkbbjaannlpib",
        "JD_STORES_ONLY_EXTENSION_IDS": "nipicallldlddjelmaghkbbjaannlpib",
        "SYCM_ONLY_EXTENSION_IDS": "nipicallldlddjelmaghkbbjaannlpib",
        "ALIMAMA_ONLY_EXTENSION_IDS": "nipicallldlddjelmaghkbbjaannlpib",
        "TB_ACCOUNT_ONLY_EXTENSION_IDS": "nipicallldlddjelmaghkbbjaannlpib",
        "TB_STORES_ONLY_EXTENSION_IDS": "nipicallldlddjelmaghkbbjaannlpib",
        "START_MCP_TIMEOUT_MS": "120000",
        "RUN_MCP_TIMEOUT_MS": "600000"
      }
    }
  }
}
